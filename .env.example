VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Drive picker (Google Cloud Console → APIs & Services → Credentials)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Cloud Console → página principal del proyecto → tarjeta "Project info" → "Project number"
VITE_GOOGLE_APP_ID=

# Dropbox Chooser (Dropbox App Console → App key)
VITE_DROPBOX_APP_KEY=

# OneDrive picker v8 (Azure App registrations → Application (client) ID).
# Requiere una plataforma "Single-page application" con redirect URI
# http://localhost:5173 (no la plataforma "Web").
VITE_MS_CLIENT_ID=

# Proveedor/modelo de IA para el análisis rubricado (opcionales; defaults:
# gemini / gemini-2.5-flash). Soportados: gemini | qwen | twelvelabs.
VITE_ANALYSIS_PROVIDER=
VITE_ANALYSIS_MODEL=
